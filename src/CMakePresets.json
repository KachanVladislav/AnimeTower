{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/../build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "description": "/W4 only for C++; C uses default(for raylib - to many warnings)",
                "CMAKE_C_FLAGS": "/Zi /Od",
                "CMAKE_CXX_FLAGS": "/W4 /Zi /Od"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/../build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS": "/O2",
                "CMAKE_CXX_FLAGS": "/W4 /O2"
            }
        },
        {
            "name": "dist",
            "displayName": "Dist (no console)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/../build/dist",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_NO_CONSOLE": "ON",
                "CMAKE_C_FLAGS": "/O2",
                "CMAKE_CXX_FLAGS": "/W4 /O2"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "dist",
            "displayName": "Dist (no console)",
            "configurePreset": "dist",
            "configuration": "Release"
        }
    ]
}
