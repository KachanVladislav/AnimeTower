# Doxyfile for AnimeTower
# Generate: doxygen Doxyfile
# Output: doxygen/html/ and doxygen/latex/

# Project
PROJECT_NAME           = "AnimeTower"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Game with raylib"

# Input
INPUT                  = src
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */3rdParty/*

# Output
OUTPUT_DIRECTORY       = doxygen
HTML_OUTPUT            = html
LATEX_OUTPUT           = latex
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Diagrams (requires Graphviz)
DOT_PATH               = "C:/Program Files/Graphviz/bin"
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
TEMPLATE_RELATIONS     = YES
UML_LOOK               = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
SHOW_USED_FILES        = YES

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Other
QUIET                  = NO
WARNINGS               = YES
JAVADOC_AUTOBRIEF      = YES
