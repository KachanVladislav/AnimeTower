{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug atGame",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target atGame",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Release atGame",
            "type": "shell",
            "command": "cmake --preset release ; cmake --build --preset release --target atGame",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Dist atGame",
            "type": "shell",
            "command": "cmake --preset dist ; cmake --build --preset dist --target atGame",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Debug atTests",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target atTests",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Release atTests",
            "type": "shell",
            "command": "cmake --preset release ; cmake --build --preset release --target atTests",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Debug atTileTemplateGenerator",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target atTileTemplateGenerator",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build default - debug all",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target atTests ; cmake --build --preset debug --target atGame ; cmake --build --preset debug --target atTileTemplateGenerator",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Delete Build",
            "type": "shell",
            "command": "if (Test-Path '${workspaceFolder}/build') { Remove-Item -Recurse -Force '${workspaceFolder}/build' }",
            "group": "build"
        }
    ]
}
