{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": ["-d"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": ["-r"],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rmdir",
            "args": ["/s", "/q", "${workspaceFolder}/build"],
            "problemMatcher": []
        }
    ]
}
