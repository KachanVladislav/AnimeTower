{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug AnimeTower",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target AnimeTower",
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Release AnimeTower",
            "type": "shell",
            "command": "cmake --preset release ; cmake --build --preset release --target AnimeTower",
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Dist AnimeTower",
            "type": "shell",
            "command": "cmake --preset dist ; cmake --build --preset dist --target AnimeTower",
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Debug AnimeTower_Tests",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target AnimeTower_Tests",
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build Release AnimeTower_Tests",
            "type": "shell",
            "command": "cmake --preset release ; cmake --build --preset release --target AnimeTower_Tests",
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Build default - debug all",
            "type": "shell",
            "command": "cmake --preset debug ; cmake --build --preset debug --target AnimeTower_Tests ; cmake --build --preset debug --target AnimeTower",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Delete Build",
            "type": "shell",
            "command": "if (Test-Path '${workspaceFolder}/build') { Remove-Item -Recurse -Force '${workspaceFolder}/build' }",
            "group": "build"
        }
    ]
}